NOTIFICATION_EMAIL_FROM="ISP-OS <notifications@example.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
ARKESEL_API_KEY=""
SMS_SENDER_ID="NexaWiFi"

# Production Compose image references (required only by docker-compose.production.yml)
ISP_OS_WEB_IMAGE=""
ISP_OS_CAPTIVE_PORTAL_IMAGE=""
ISP_OS_WORKER_IMAGE=""
