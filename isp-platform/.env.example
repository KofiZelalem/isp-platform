NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_placeholder"

# Network agent control channel
NETWORK_AGENT_URL="http://127.0.0.1:8090"
NETWORK_AGENT_CONTROL_URL=""
NETWORK_AGENT_ID=""
NETWORK_AGENT_NODE_ID=""
NETWORK_AGENT_ALLOWED_NODE_IDS=""
NETWORK_AGENT_BIND_HOST="127.0.0.1"
NETWORK_AGENT_PORT="8090"

# RADIUS proxy runtime
RADIUS_WEB_BASE_URL="http://web:3000"
RADIUS_API_KEY=""
RADIUS_BIND_HOST="0.0.0.0"
RADIUS_PORT="1812"

# WireGuard cloud peer
WIREGUARD_SERVER_PUBLIC_KEY="replace_with_44_character_base64_key"
WIREGUARD_SERVER_ENDPOINT="vpn.example.com"
WIREGUARD_SERVER_PORT="51820"
WIREGUARD_SERVER_NETWORK="10.77.0.0/24"

# Optional real MikroTik API smoke test (run from packages/mikrotik)
MIKROTIK_HOST="192.168.88.1"
MIKROTIK_PORT="8728"
MIKROTIK_USERNAME="admin"
MIKROTIK_PASSWORD=""
MIKROTIK_TIMEOUT_MS="4000"

# Optional notification providers
