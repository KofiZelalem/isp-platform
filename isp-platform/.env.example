# Database
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/ispos_db?schema=public"
DIRECT_URL="postgresql://postgres:change-me@localhost:5432/ispos_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Required application secrets (generate unique values; never use these names as passwords)
ISP_OS_CREDENTIALS_ENCRYPTION_KEY=""
PORTAL_AUTH_SECRET=""
ISP_OS_WORKER_SECRET=""
