upstream isp_web {
  server web:3000;
}

upstream isp_captive_portal {
  server captive-portal:3002;
}

server {
  listen 80;
  server_name ${WEB_DOMAIN};

  location / {
    proxy_pass http://isp_web;
    proxy_set_header Host $$host;
    proxy_set_header X-Forwarded-Proto $$scheme;
    proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
  }
}

server {
  listen 80;
  server_name ${PORTAL_DOMAIN};

  location / {
    proxy_pass http://isp_captive_portal;
    proxy_set_header Host $$host;
    proxy_set_header X-Forwarded-Proto $$scheme;
    proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
  }
}