FROM node:20-alpine

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter captive-portal run build \
  && pnpm store prune

ENV NODE_ENV=production
EXPOSE 3002
CMD ["pnpm", "--filter", "captive-portal", "run", "start"]