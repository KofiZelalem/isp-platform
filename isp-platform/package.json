{
  "name": "isp-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter web test",
    "db:push": "pnpm --filter database run db:push",
    "db:generate": "pnpm --filter database run db:generate",
    "db:seed": "pnpm --filter database run seed",
    "db:migrate:status": "pnpm --filter database run db:migrate:status",
    "db:migrate:deploy": "pnpm --filter database run db:migrate:deploy",
    "credentials:migrate": "pnpm --filter mikrotik run credentials:migrate",
    "typecheck": "pnpm --filter web exec tsc --noEmit && pnpm --filter mikrotik run typecheck && pnpm --filter network-agent run typecheck && pnpm --filter radius-service run typecheck && pnpm --filter worker run typecheck && pnpm --filter database run typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0"
}
